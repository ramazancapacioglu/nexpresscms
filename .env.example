# ============================================================================
# NEXPRESS CMS — ORTAM YAPILANDIRMASI (.env)
# ============================================================================

# 1. ÇALIŞMA MODU (Single-Tenant vs Subdomain Multi-Tenant Demo/SaaS)
# "single"          -> Varsayılan tek site kurulumu (siteId = 'default')
# "multi_subdomain" -> firma.demo.nexpress.com ile izole alt alan adı modu
CMS_MODE="single"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. VERİTABANI MOTORU SEÇİMİ ("sqlite" | "postgresql")
# - Hızlı Docker'sız başlangıç için: DB_DIALECT="sqlite"
# - Geniş Paket (Docker pgvector) için: DB_DIALECT="postgresql"
DB_DIALECT="postgresql"

# Seçenek A: LibSQL / SQLite (Sıfır-Docker Yerel Dosya veya Turso)
SQLITE_URL="file:./data/nexpress.db"

# Seçenek B: PostgreSQL 16 + pgvector (Docker Compose: port 5434)
DATABASE_URL="postgresql://nexpress:nexpress_secret_password@localhost:5434/nexpress_cms"

# 3. REDIS & BULLMQ (Pro Eklentiler & Arka Plan AI Kuyruğu)
REDIS_URL="redis://localhost:6381"

# 4. KİMLİK DOĞRULAMA & GÜVENLİK
AUTH_SECRET="nexpress-super-secret-jwt-key-change-in-production-2026"
ADMIN_DEFAULT_EMAIL="admin@nexpress.local"
ADMIN_DEFAULT_PASSWORD="Admin123!"

# 5. PRO EKLENTİLER & AI / RAG ANAHTARLARI (Opsiyonel)
# Arama dizini (RAG) gömme sağlayıcısı: "local" (anahtarsız, sözcüksel) veya "openai" (anlamsal).
# Boşsa OPENAI_API_KEY varsa openai, yoksa local seçilir. Sağlayıcı değişirse "Dizini yeniden oluştur" çalıştırın.
# EMBEDDING_PROVIDER=""
# EMBEDDING_MODEL="text-embedding-3-small"
# OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
SERPER_API_KEY=""
# MCP yazma araçları (X-Agent-Key). Boşsa yazma araçları kapalıdır.
MCP_AGENT_KEY=""
# Pazar yeri sırlarını şifreleyen anahtar (boşsa AUTH_SECRET kullanılır)
SECRETS_KEY=""
# Ziyaretçi HTML'i için CDN önbelleği (sn). 0 = kapalı. DERLEME anında okunur.
PUBLIC_CACHE_SECONDS="0"
# Yüklenen görseller ve türevleri (kalıcı birim olmalı). Varsayılan: ./data/media
MEDIA_DIR="./data/media"
INDEXNOW_API_KEY="nexpress-indexnow-key"

# Zamanlanmış yayın için kesin tetikleyici (isteğe bağlı): Authorization: Bearer <değer> ile GET /api/cron/scheduled
# CRON_SECRET=""
